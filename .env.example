# Copy to .env for local `npm run dev` (do not commit .env)

# Path to nxcli.exe (auto-detected on Windows if omitted)
NETEXTENDER_CLI=C:/Program Files/SonicWall/SSL-VPN/NetExtender/nxcli.exe

# Default connection profile / server settings
NETEXTENDER_PROFILE=
NETEXTENDER_SERVER=host:port
NETEXTENDER_DOMAIN=
NETEXTENDER_USERNAME=
NETEXTENDER_PASSWORD=

# Set true to pass --always-trust on connect/add
NETEXTENDER_ALWAYS_TRUST=true
